# Manatee Device Configuration
# Copy this file to /boot/firmware/manatee.conf (Pi OS Bookworm)
# or /boot/manatee.conf (older Pi OS)
# then run setup.sh on the Pi — it will read this automatically.

MANATEE_API_KEY=mntk_PASTE_YOUR_KEY_HERE
MANATEE_SERVER_URL=https://your-server.example.com

# Audio source: "hydrophone" for live capture, "filewatcher" for testing with pre-recorded files
# MANATEE_AUDIO_SOURCE=hydrophone

# Audio device index or name for sounddevice (leave empty for system default)
# Run: python3 -c "import sounddevice; print(sounddevice.query_devices())" to list devices
# MANATEE_AUDIO_DEVICE=

# Recording segment duration in seconds (default 30 — matches the 60-clip inference window)
# MANATEE_SEGMENT_DURATION=30

# Detection aggregation thresholds (segment-level rule over per-clip outputs).
# A 30s segment becomes 60 clips of 0.5s. A real manatee call lasts ~0.2–2s,
# so only 1–4 clips are usually positive. The rule is:
#   is_manatee = (clips_positive >= MIN_POSITIVE_CLIPS) OR (max_conf >= HIGH_CONFIDENCE_THRESHOLD)
#
# Lower MIN_POSITIVE_CLIPS or HIGH_CONFIDENCE_THRESHOLD for more sensitivity (more uploads, more false positives).
# Lower CLIP_THRESHOLD only if per-clip outputs on real manatees are running below 0.5.
# MANATEE_CLIP_THRESHOLD=0.5
# MANATEE_MIN_POSITIVE_CLIPS=10
# MANATEE_HIGH_CONFIDENCE_THRESHOLD=0.90

# Upload policy: only positive detections are uploaded. To keep an eye on the
# noise floor we also ship one background sample at this cadence (seconds).
# Lower this to upload more baseline samples, raise it to save bandwidth.
# MANATEE_BASELINE_INTERVAL_SEC=900
