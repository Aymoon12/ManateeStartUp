[Unit]
Description=Manatee Detection System Device Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=manatee
Group=manatee
EnvironmentFile=/etc/manatee/config.env
Environment=NUMBA_CACHE_DIR=/var/lib/manatee/.numba_cache
ExecStart=/opt/manatee/venv/bin/python -m manatee_client.daemon
WorkingDirectory=/opt/manatee
Restart=always
RestartSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/manatee /etc/manatee
ReadOnlyPaths=/opt/manatee

# Logging (goes to journald)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=manatee-device

[Install]
WantedBy=multi-user.target
